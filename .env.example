# Optional. Used by `npm run dev` at /api/pipeline/vision and /api/pipeline/tts (never committed).
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini).
OPENAI_VISION_MODEL=gpt-4o-mini

# TTS: auto (default) uses OpenAI when a key is set, else local espeak-ng, else none.
# TTS_PROVIDER=auto
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# Browser-exposed fallback — avoid in production; prefer the server key above.
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_VISION_MODEL=gpt-4o-mini
# VITE_TTS_PROVIDER=auto

# Packaged iOS / static hosts have no Vite `/api/pipeline` server.
# Leave unset for the chair sample + fixture path (Simulator default).
# Next step for *live* create (real PDF / YouTube): deploy the pipeline API
# and point the bundled app at it, then `npm run ios:sync`.
# Same-origin `/api/pipeline/*` routes (see src/pipeline/devApi.ts).
# VITE_PIPELINE_API_URL=https://example.invalid/plainstep

# Realistic stills are an offline script (`npm run realistic`), not a runtime call.
# Same OPENAI_API_KEY as above. See docs/REALISTIC-VISUALS.md.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_FIDELITY=high
