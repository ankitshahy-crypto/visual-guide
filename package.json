{
  "name": "visual-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts",
    "render:all": "node scripts/render-all.mjs",
    "validate": "python3 scripts/validate.py",
    "narrate": "node scripts/generate-narration.mjs",
    "test": "vitest run",
    "test:pipeline": "vitest run src/pipeline src/lib",
    "ios:sync": "CAPACITOR_IOS_BUILD=1 npm run build && npx cap sync ios && node scripts/check-ios-bundle.mjs",
    "ios:open": "node scripts/ios-open.mjs",
    "ios:live-sync": "CAPACITOR_LIVE_RELOAD=${CAPACITOR_LIVE_RELOAD:-http://localhost:5173} npm run ios:sync"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/player": "4.0.526",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "remotion": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/player": "4.0.526"
  }
}
